*.cdx.xml

# Third-party specification PDFs: public references, kept out of history
/docs/windows/
*.pdf

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local Claude Code settings
.claude/settings.local.json

# Portal (ADR-0020): npm packages and build output, never versioned
/portal/node_modules/
/portal/dist/
/portal/src/wasm/
