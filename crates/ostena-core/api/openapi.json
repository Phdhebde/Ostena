            "username": "alice",
            "channel": "cli",
            "started_at": 1800000000,
            "expires_at": 1800028800
          }
        ]
      },
      "LoginSessionList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/LoginSessionItem"
            }
          }
        },
        "examples": [
          {
            "sessions": [
              {
                "id": "0b8f4c1e-7a52-4d0e-9f3b-2c6d1a9e8f70",
                "user": "5a1d2c3b-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                "username": "alice",
                "channel": "web",
                "started_at": 1800000000,
                "expires_at": 1800028800
              }
            ]
          },
          {
            "sessions": []
          }
        ]
      },
      "RevokeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Sans caractère de contrôle ; écrite dans la chaîne d'audit."
          }
        },
        "examples": [
          {
            "reason": "poste de l'utilisateur perdu"
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}-E[0-9]{3}$",
            "description": "Code stable, que le portail traduit et affiche."
          },
          "message": {
            "type": "string",
            "maxLength": 512,
            "description": "Pour les journaux et les tests ; le portail ne l'affiche jamais."
          }
        },
        "examples": [
          {
            "code": "WEB-E001",
            "message": "session absente, expirée ou révoquée"
          },
          {
            "code": "AUTH-E001",
            "message": "identifiants invalides ou compte indisponible"
          }
        ]
      },
      "AccessProtocol": {
        "type": "string",
        "enum": [
          "ssh"
        ],
        "description": "Protocole demandé ; RDP viendra avec l'affichage de la PR 13.",
        "examples": [
          "ssh"
        ]
      },
      "AccessRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "account",
          "protocol"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$",
            "description": "Nom de la ressource dans l'inventaire."
          },
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Compte sur la ressource, sans caractère de contrôle ni espace aux extrémités."
          },
          "protocol": {
            "$ref": "#/components/schemas/AccessProtocol"
          }
        },
        "examples": [
          {
            "resource": "srv-web-01",
            "account": "root",
            "protocol": "ssh"
          }
        ]
      },
      "AccessGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant",
          "resource",
          "account",
          "protocol",
          "expires_at",
          "max_session_secs"
        ],
        "properties": {
          "grant": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{246}$",
            "description": "Le grant, forme texte (ADR-0004), à présenter dans le sous-protocole ostena-grant.<grant>, jamais dans l'URL."
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
          },
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "protocol": {
            "$ref": "#/components/schemas/AccessProtocol"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 1,
            "description": "Fin de validité du grant, secondes Unix (émission + 60 s)."
          },
          "max_session_secs": {
            "type": "integer",
            "minimum": 1,
            "description": "Durée de session la plus longue permise : le droit, sa fin et la session de connexion."
          }
        },
        "examples": [
          {
            "grant": "AQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "resource": "srv-web-01",
            "account": "root",
            "protocol": "ssh",
            "expires_at": 1800000060,
            "max_session_secs": 3600
          }
        ]
      }
    }
  }
